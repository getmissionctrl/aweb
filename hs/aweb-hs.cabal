cabal-version: 3.0
name:          aweb-hs
version:       0.1.0
synopsis:      aweb coordination server (Haskell)
license:       MIT
build-type:    Simple

common shared
  default-language: GHC2021
  default-extensions:
    DataKinds
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    OverloadedRecordDot
    OverloadedStrings
    StrictData
    TypeFamilies
    TypeOperators
  ghc-options: -Wall -Wunused-packages

library
  import: shared
  hs-source-dirs: src
  exposed-modules:
    Aweb.API
    Aweb.API.Types
    Aweb.Auth.DID
    Aweb.Auth.Middleware
    Aweb.Auth.Registry
    Aweb.Auth.Signing
    Aweb.Config
    Aweb.DB
    Aweb.DB.Agents
    Aweb.DB.Messages
    Aweb.DB.Repos
    Aweb.DB.Reservations
    Aweb.DB.Schema
    Aweb.DB.Tasks
    Aweb.DB.TeamConfig
    Aweb.DB.Workspaces
    Aweb.Handlers.Agents
    Aweb.Handlers.Claims
    Aweb.Handlers.Conversations
    Aweb.Handlers.Dashboard
    Aweb.Handlers.Instructions
    Aweb.Handlers.Messages
    Aweb.Handlers.Repos
    Aweb.Handlers.Reservations
    Aweb.Handlers.Roles
    Aweb.Handlers.Tasks
    Aweb.Handlers.Workspaces
    Aweb.Nats
    Aweb.Nats.AuthCallout
    Aweb.Nats.Presence
    Aweb.Nats.Publish
    Aweb.Nats.Subjects
    Aweb.Nats.Subscriber
    Aweb.Service
  build-depends:
    base >= 4.18 && < 5,
    aeson >= 2.2,
    base58-bytestring,
    base64-bytestring,
    bytestring,
    containers,
    crypton,
    hasql >= 1.6,
    hasql-pool >= 1.0,
    http-client,
    http-client-tls,
    http-types,
    memory,
    optparse-applicative >= 0.18,
    rel8 >= 1.5,
    servant-server,
    stm,
    text,
    time,
    uuid,
    wai,
    warp

executable aweb-hs
  import: shared
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    base,
    aweb-hs,
    optparse-applicative >= 0.18,
    text

test-suite aweb-hs-test
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    Aweb.Auth.DIDSpec
    Aweb.Auth.SigningSpec
    Aweb.API.HealthSpec
  ghc-options: -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    base,
    aweb-hs,
    bytestring,
    hspec,
    hspec-discover,
    hspec-wai,
    hspec-wai-json,
    text
